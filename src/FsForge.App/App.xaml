<Application
    x:Class="FsForge.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:FsForge.App.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:TextToVisibilityConverter x:Key="TextToVisibility" />
            <conv:NodeIconConverter x:Key="NodeIcon" />
            <conv:MessageKindToSeverityConverter x:Key="KindToSeverity" />
            <conv:FolderEmphasisConverter x:Key="FolderEmphasis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
