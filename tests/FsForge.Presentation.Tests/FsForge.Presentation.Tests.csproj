<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain console runner (no test framework needed): dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FsForge.Presentation.Tests</RootNamespace>
  </PropertyGroup>

  <!-- UBIFS and UBI are read-only formats: the test images come from the builder of the built-in core tests. -->
  <ItemGroup>
    <Compile Include="..\..\tools\FsForge.Cli\UbifsImageBuilder.cs" Link="UbifsImageBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FsForge.Presentation\FsForge.Presentation.csproj" />
  </ItemGroup>

</Project>
